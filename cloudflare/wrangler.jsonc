{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dungeon-access-edge",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "aneeketdas.com/dungeon*",
      "zone_name": "aneeketdas.com"
    }
  ],
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dungeon-learner-state",
      "database_id": "8b1322ae-9016-4632-8f47-5fa15c64475f",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "COURSE_RAG",
      "index_name": "dungeon-t6-course-rag-v1"
    }
  ],
  "vars": {
    "DUNGEON_PREFIX": "/dungeon",
    "ACCESS_ACCOUNT_ID": "c9ad5ea00fe0040b372163daf10ea235",
    "ACCESS_GROUP_ID": "e74be54f-b714-44ea-95cb-11ed66777f18",
    "ACCESS_TEAM_DOMAIN": "https://dawn-unit-8689.cloudflareaccess.com",
    "ACCESS_ADMIN_AUD": "4835199408cc2b98c8ece55b29877e4bc98411a2e052b011fe0b19512f307105",
    "OWNER_EMAIL": "beyondthenoisestudios@gmail.com",
    "DUNGEON_HOSTED_WRITTEN": "off",
    "DUNGEON_HOSTED_WRITTEN_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "DUNGEON_HOSTED_WRITTEN_APPROVED_MODEL": "not-approved",
    "DUNGEON_HOSTED_EMBEDDING_MODEL": "@cf/qwen/qwen3-embedding-0.6b",
    "DUNGEON_HOSTED_WRITTEN_CORPUS": "not-indexed",
    "DUNGEON_HOSTED_WRITTEN_DAILY_LIMIT": "8",
    "DUNGEON_HOSTED_WRITTEN_COHORT_DAILY_LIMIT": "140"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
